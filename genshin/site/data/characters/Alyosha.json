aram4":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15],"param5":[0.1166,0.1272,0.1378,0.1484,0.159,0.1696,0.1802,0.1908,0.2014,0.212,0.22472,0.23744,0.25016,0.26288,0.2756],"param6":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15]}},"combat3":{"name":"守猎进踞","desc":"召唤信赖的好伙伴图加林一同战斗，并将前方区域短暂变换为轰霆猎场。\n\n轰霆猎场\n·持续嘲讽周围的敌人，吸引敌人攻击；\n·每隔2秒，对踏入其中的敌人造成一次雷元素范围伤害。\n\n图加林\n·若周围存在敌人，每隔2秒，图加林将快速移动至一名敌人附近，对其进行撕咬攻击，造成雷元素伤害。\n·若命中的敌人处于弋猎印记效果影响下，还会激活弋猎印记。\n·图加林会优先攻击处于弋猎印记效果影响下的敌人。","labels":["轰霆猎场伤害|{param1:F1P}","图加林伤害|{param2:F1P}","持续时间|{param3:F1}秒","冷却时间|{param4:F1}秒","元素能量|{param5:I}"],"params":{"param1":[0.7496,0.80582,0.86204,0.937,0.99322,1.04944,1.1244,1.19936,1.27432,1.34928,1.42424,1.4992,1.5929,1.6866,1.7803],"param2":[0.502232,0.539899,0.577567,0.62779,0.665457,0.703125,0.753348,0.803571,0.853794,0.904018,0.954241,1.004464,1.067243,1.130022,1.192801],"param3":[14,14,14,14,14,14,14,14,14,14,14,14,14,14,14],"param4":[18,18,18,18,18,18,18,18,18,18,18,18,18,18,18],"param5":[70,70,70,70,70,70,70,70,70,70,70,70,70,70,70]}}},"passives":[{"name":"惊醒沉睡的林线","desc":"**图加林**进行攻击时，还会为队伍中附近的当前场上角色恢复生命值，回复量相当于阿罗夏攻击力的120%。"},{"name":"告别冬麦与残叶","desc":"基于阿罗夏的元素充能效率，提升阿罗夏的元素战技与元素爆发造成的伤害：每1%元素充能效率都会使上述伤害提升0.35%，至多提升至70%。"},{"name":"星赴险域","desc":"处于**极星辉域**中时，阿罗夏将会进入辉映·星超导状态。\n辉映·星超导：激活**弋猎印记**时获得的猎者之准效果还会使角色处于场上时造成的星超导反应伤害提升20%。"}],"icon":"assets/avatars/UI_AvatarIcon_Alyosha.png"}