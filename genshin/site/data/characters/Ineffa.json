184,2.377728,2.543616,2.7648,2.930688,3.096576,3.31776,3.538944,3.760128,3.981312,4.202496,4.42368,4.70016,4.97664,5.25312],"param3":[1386.6759,1525.3628,1675.6068,1837.4082,2010.7667,2195.6826,2392.1558,2600.186,2819.7734,3050.9182,3293.6204,3547.8796,3813.696,4091.0698,4380.0005],"param4":[0.96,1.032,1.104,1.2,1.272,1.344,1.44,1.536,1.632,1.728,1.824,1.92,2.04,2.16,2.28],"param5":[20,20,20,20,20,20,20,20,20,20,20,20,20,20,20],"param6":[20,20,20,20,20,20,20,20,20,20,20,20,20,20,20],"param7":[16,16,16,16,16,16,16,16,16,16,16,16,16,16,16]}},"combat3":{"name":"至高律令·全域扫灭","desc":"借助多用途智能辅助单元**「薇尔琪塔」**，使用火箭飞拳清扫敌人！伊涅芙发射出薇尔琪塔，造成雷元素范围伤害，并使薇尔琪塔停留在场上。\n\n若场上存在伊涅芙自己召唤的薇尔琪塔，则改为在目标位置重新召唤薇尔琪塔，并重置其持续时间。","labels":["技能伤害|{param1:F1P}","冷却时间|{param2:F1}秒","元素能量|{param3:I}"],"params":{"param1":[6.768,7.2756,7.7832,8.46,8.9676,9.4752,10.152,10.8288,11.5056,12.1824,12.8592,13.536,14.382,15.228,16.074],"param2":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15],"param3":[60,60,60,60,60,60,60,60,60,60,60,60,60,60,60]}}},"passives":[{"name":"频率超限回路","desc":"若**「薇尔琪塔」**附近存在月感电反应产生的雷暴云，薇尔琪塔进行放电攻击时，将额外进行一次攻击，造成相当于伊涅芙攻击力65%的雷元素范围伤害，该伤害视为月感电反应造成的伤害。"},{"name":"全相重构协议","desc":"施放元素爆发**至高律令·全域扫灭**时，将为队伍中自己的所有角色赋予「参数重构」效果：基于伊涅芙攻击力的6%，提升伊涅芙与队伍中自己当前场上角色的元素精通，持续20秒。"},{"name":"月兆祝赐·象拟中继","desc":"队伍中的角色触发感电反应时，将转为触发月感电反应，且基于伊涅芙的攻击力，提升月感电反应的基础伤害：每100点攻击力都将提升0.7%基础伤害，至多通过这种方式提升14%伤害。\n\n此外，伊涅芙在队伍中时，队伍的月兆将会上升一级。"}],"icon":"assets/avatars/UI_AvatarIcon_Ineffa.png"}