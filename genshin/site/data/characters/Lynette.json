期间伤害|{param9:F1P}","低空/高空坠地冲击伤害|{param10:P}/{param11:P}"],"params":{"param1":[0.430817,0.465884,0.50095,0.551045,0.586112,0.626188,0.681292,0.736397,0.791501,0.851615,0.911729,0.971843,1.031957,1.092071,1.152185],"param2":[0.376121,0.406736,0.43735,0.481085,0.511699,0.546687,0.594796,0.642904,0.691013,0.743495,0.795977,0.848459,0.900941,0.953423,1.005905],"param3":[0.27864,0.30132,0.324,0.3564,0.37908,0.405,0.44064,0.47628,0.51192,0.5508,0.58968,0.62856,0.66744,0.70632,0.7452],"param4":[0.215929,0.233504,0.25108,0.276188,0.293764,0.31385,0.341469,0.369088,0.396706,0.426836,0.456966,0.487095,0.517225,0.547354,0.577484],"param5":[0.631541,0.682945,0.73435,0.807785,0.859189,0.917937,0.998716,1.079494,1.160273,1.248395,1.336517,1.424639,1.512761,1.600883,1.689005],"param6":[0.44204,0.47802,0.514,0.5654,0.60138,0.6425,0.69904,0.75558,0.81212,0.8738,0.93548,0.99716,1.05884,1.12052,1.1822],"param7":[0.61404,0.66402,0.714,0.7854,0.83538,0.8925,0.97104,1.04958,1.12812,1.2138,1.29948,1.38516,1.47084,1.55652,1.6422],"param8":[20,20,20,20,20,20,20,20,20,20,20,20,20,20,20],"param9":[0.639324,0.691362,0.7434,0.81774,0.869778,0.92925,1.011024,1.092798,1.174572,1.26378,1.352988,1.442196,1.531404,1.620612,1.70982],"param10":[1.278377,1.382431,1.486485,1.635134,1.739187,1.858106,2.02162,2.185133,2.348646,2.527025,2.705403,2.883781,3.062159,3.240537,3.418915],"param11":[1.596762,1.726731,1.8567,2.04237,2.172339,2.320875,2.525112,2.729349,2.933586,3.15639,3.379194,3.601998,3.824802,4.047606,4.27041]}},"combat2":{"name":"谜影障身法","desc":"挥舞斗篷，击出谜影突刺，造成风元素伤害。\n谜影突刺命中敌人时，将为琳妮特恢复生命值，回复量基于琳妮特的生命值上限，并在此后的4秒内，每秒将消耗一定的生命值。\n依据点按、长按，以不同的方式击出谜影突刺。\n\n点按\n迅速击出谜影突刺。 \n\n长按\n琳妮特以「谜身影盗」的姿态疾走，并对附近的敌人施加「刺影征标」。期间可以控制疾走的方向，并能通过再次施放技能，提前结束疾走状态。\n疾走结束时，琳妮特将击出谜影突刺。若附近存在具有刺影征标的敌人，琳妮特将在击出谜影突刺前高速闪掠接近该敌人。\n\n同时至多有一名敌人具有琳妮特自身施加的刺影征标。与具有刺影征标的敌人距离过远时，将移除该刺影征标。\n\n始基力：荒性\n每隔一段时间，琳妮特击出谜影突刺时，将唤出流涌之刃，造成具有荒性的风元素伤害。","labels":["谜影突刺伤害|{param1:F1P}","流涌之刃伤害|{param3:F1P}","流涌之刃间隔|{param8:F1}秒","命中治疗量|{param4:P}生命值上限","生命值消耗|{param6:P}当前生命值/秒","长按最大持续时间|{param9:F1}秒","冷却时间|{param7:F1}秒"],"params":{"param1":[2.68,2.881,3.082,3.35,3.551,3.752,4.02,4.288,4.556,4.824,5.092,5.36,5.695,6.03,6.365],"param2":[2.68,2.881,3.082,3.35,3.551,3.752,4.02,4.288,4.556,4.824,5.092,5.36,5.695,6.03,6.365],"param3":[0.312,0.3354,0.3588,0.39,0.4134,0.4368,0.468,0.4992,0.5304,0.5616,0.5928,0.624,0.663,0.702,0.741],"param4":[0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25,0.25],"param6":[0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06,0.06],"param7":[12,12,12,12,12,12,12,12,12,12,12,12,12,12,12],"param8":[10,10,10,10,10,10,10,10,10,10,10,10,10,10,10],"param9":[2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5,2.5]}},"combat3":{"name":"魔术·运变惊奇","desc":"琳妮特高举斗篷造成风元素范围伤害，用惊人的手法变出巨大的惊奇猫猫盒！\n\n惊奇猫猫盒\n·能够持续嘲讽周围的敌人，吸引敌人攻击；\n·将周期性对附近的敌人造成风元素伤害；\n·惊奇猫猫盒接触了水元素/火元素/冰元素/雷元素，则会获得对应元素属性，周期性对附近的敌人追加发射彩练术弹，造成该元素的伤害。\n元素转化在技能持续期间仅会发生一次。","labels":["技能伤害|{param1:F1P}","惊奇猫猫盒伤害|{param2:F1P}","彩练术弹伤害|{param3:F1P}","惊奇猫猫盒持续时间|{param4:F1}秒","冷却时间|{param5:F1}秒","元素能量|{param6:I}"],"params":{"param1":[0.832,0.8944,0.9568,1.04,1.1024,1.1648,1.248,1.3312,1.4144,1.4976,1.5808,1.664,1.768,1.872,1.976],"param2":[0.512,0.5504,0.5888,0.64,0.6784,0.7168,0.768,0.8192,0.8704,0.9216,0.9728,1.024,1.088,1.152,1.216],"param3":[0.456,0.4902,0.5244,0.57,0.6042,0.6384,0.684,0.7296,0.7752,0.8208,0.8664,0.912,0.969,1.026,1.083],"param4":[12,12,12,12,12,12,12,12,12,12,12,12,12,12,12],"param5":[18,18,18,18,18,18,18,18,18,18,18,18,18,18,18],"param6":[70,70,70,70,70,70,70,70,70,70,70,70,70,70,70]}}},"passives":[{"name":"巧施协同","desc":"施放魔术·运变惊奇后的10秒内，队伍中分别存在1/2/3/4种元素类型的角色时，队伍中所有角色的攻击力分别提升8%/12%/16%/20%。"},{"name":"道具完备","desc":"魔术·运变惊奇召唤的惊奇猫猫盒发生了元素转化后，琳妮特元素爆发造成的伤害提升15%，效果持续至该惊奇猫猫盒持续时间结束。"},{"name":"点位记忆法","desc":"在小地图上显示周围复苏水团的位置，并使接触复苏水团时恢复的水中耐力与生命值提升25%。"}],"icon":"assets/avatars/UI_AvatarIcon_Linette.png"}