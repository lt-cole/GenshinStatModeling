徽记形成的速度，并为那维莱特恢复生命值。\n停止蓄力时，若徽记尚不完满，将进行重击；若已经完满，则将转为进行重击·衡平推裁。\n\n重击\n消耗一定体力，以迸发的水环猛击敌人，造成水元素范围伤害。\n\n重击·衡平推裁\n释放汹涌的洪流，对前方直线区域内的敌人持续造成水元素范围伤害。\n重击·衡平推裁不消耗体力，持续3秒。\n若生命值高于50%，那维莱特在施放时将持续消耗生命值。\n\n下落攻击\n凝聚水元素的力量，从空中下坠冲击地面，攻击下落路径上的敌人，并在落地时造成水元素范围伤害。","labels":["一段伤害|{param1:F1P}","二段伤害|{param2:F1P}","三段伤害|{param3:F1P}","重击伤害|{param4:F1P}","重击体力消耗|{param6:F1}点","重击·衡平推裁持续伤害|{param5:F2P}生命值上限","恢复生命值|{param7:F1P}生命值上限/枚","损失生命值|{param8:F1P}生命值上限/{param9:F1}秒","下坠期间伤害|{param11:F1P}","低空/高空坠地冲击伤害|{param12:P}/{param13:P}"],"params":{"param1":[0.545768,0.586701,0.627633,0.68221,0.723143,0.764075,0.818652,0.873229,0.927806,0.982382,1.036959,1.091536,1.159757,1.227978,1.296199],"param2":[0.462456,0.49714,0.531824,0.57807,0.612754,0.647438,0.693684,0.73993,0.786175,0.832421,0.878666,0.924912,0.982719,1.040526,1.098333],"param3":[0.723376,0.777629,0.831882,0.90422,0.958473,1.012726,1.085064,1.157402,1.229739,1.302077,1.374414,1.446752,1.537174,1.627596,1.718018],"param4":[1.368,1.4706,1.5732,1.71,1.8126,1.9152,2.052,2.1888,2.3256,2.4624,2.5992,2.736,2.907,3.078,3.249],"param5":[0.073186,0.079143,0.0851,0.09361,0.099567,0.106375,0.115736,0.125097,0.134458,0.14467,0.154882,0.165094,0.175306,0.185518,0.19573],"param6":[50,50,50,50,50,50,50,50,50,50,50,50,50,50,50],"param7":[0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16,0.16],"param8":[0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08,0.08],"param9":[0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5],"param10":[0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5,0.5],"param11":[0.568288,0.614544,0.6608,0.72688,0.773136,0.826,0.898688,0.971376,1.044064,1.12336,1.202656,1.281952,1.361248,1.440544,1.51984],"param12":[1.136335,1.228828,1.32132,1.453452,1.545944,1.65165,1.796995,1.94234,2.087686,2.246244,2.404802,2.563361,2.721919,2.880478,3.039036],"param13":[1.419344,1.534872,1.6504,1.81544,1.930968,2.063,2.244544,2.426088,2.607632,2.80568,3.003728,3.201776,3.399824,3.597872,3.79592]}},"combat2":{"name":"泪水啊，我必偿还","desc":"降下汹涌的水瀑，基于那维莱特的生命值上限，对前方的敌人造成水元素范围伤害，命中敌人后，将在敌人附近产生3枚源水之滴。\n\n始基力：芒性\n每隔一段时间，在降下汹涌的水瀑后，将降下穿透敌人的灵息之刺，造成具有芒性的水元素伤害。","labels":["技能伤害|{param1:F2P}生命值上限","灵息之刺伤害|{param2:F1P}","灵息之刺间隔|{param5:F1}秒","源水之滴持续时间|{param3:F1}秒","冷却时间|{param4:F1}秒"],"params":{"param1":[0.12864,0.138288,0.147936,0.1608,0.170448,0.180096,0.19296,0.205824,0.218688,0.231552,0.244416,0.25728,0.27336,0.28944,0.30552],"param2":[0.208,0.2236,0.2392,0.26,0.2756,0.2912,0.312,0.3328,0.3536,0.3744,0.3952,0.416,0.442,0.468,0.494],"param3":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15],"param4":[12,12,12,12,12,12,12,12,12,12,12,12,12,12,12],"param5":[10,10,10,10,10,10,10,10,10,10,10,10,10,10,10]}},"combat3":{"name":"潮水啊，我已归来","desc":"释放迸发的骇浪，基于那维莱特的生命值上限，造成水元素范围伤害，短暂间隔后，在附近降下2道水瀑，造成范围较小的水元素伤害，并在前方一定范围内产生6枚源水之滴。","labels":["技能伤害|{param1:F2P}生命值上限","水瀑伤害|{param2:F2P}生命值上限","冷却时间|{param3:F1}秒","元素能量|{param4:I}"],"params":{"param1":[0.222578,0.239272,0.255965,0.278223,0.294916,0.31161,0.333868,0.356125,0.378383,0.400641,0.422899,0.445157,0.472979,0.500801,0.528624],"param2":[0.091055,0.097884,0.104713,0.113818,0.120647,0.127477,0.136582,0.145688,0.154793,0.163898,0.173004,0.182109,0.193491,0.204873,0.216255],"param3":[18,18,18,18,18,18,18,18,18,18,18,18,18,18,18],"param4":[70,70,70,70,70,70,70,70,70,70,70,70,70,70,70]}}},"passives":[{"name":"古海孑遗的权柄","desc":"队伍中的角色对敌人触发蒸发、冻结、感电、月感电、绽放、月绽放、水元素扩散、水元素结晶或月结晶反应时，将为那维莱特产生持续30秒，至多叠加3层的「遗龙之荣」效果，使重击·衡平推裁造成原本110%/125%/160%的伤害。\n每种元素反应产生的「遗龙之荣」分别独立存在。"},{"name":"至高仲裁的纪律","desc":"基于当前生命值超出生命值上限30%的部分，每1%使那维莱特获得0.6%水元素伤害加成，通过这种方式，至多提升30%。"},{"name":"汇聚如浪潮一般","desc":"队伍中自己的角色进行水下冲刺时，移动速度提升15%。\n无法与效果完全相同的固有天赋叠加。"}],"icon":"assets/avatars/UI_AvatarIcon_Neuvillette.png"}