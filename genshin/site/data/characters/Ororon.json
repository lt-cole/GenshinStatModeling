tk":178.5,"def":429.1,"sp":0.12},{"lv":65,"asc":4,"hp":6820.5,"atk":180.2,"def":433.1,"sp":0.12},{"lv":66,"asc":4,"hp":6884.8,"atk":181.9,"def":437.2,"sp":0.12},{"lv":67,"asc":4,"hp":6949.1,"atk":183.6,"def":441.3,"sp":0.12},{"lv":68,"asc":4,"hp":7012.7,"atk":185.3,"def":445.3,"sp":0.12},{"lv":69,"asc":4,"hp":7077,"atk":187,"def":449.4,"sp":0.12},{"lv":70,"asc":4,"hp":7140.6,"atk":188.7,"def":453.4,"sp":0.12},{"lv":71,"asc":5,"hp":7616.3,"atk":201.3,"def":483.6,"sp":0.18},{"lv":72,"asc":5,"hp":7679.8,"atk":202.9,"def":487.7,"sp":0.18},{"lv":73,"asc":5,"hp":7744.2,"atk":204.6,"def":491.8,"sp":0.18},{"lv":74,"asc":5,"hp":7808.5,"atk":206.3,"def":495.8,"sp":0.18},{"lv":75,"asc":5,"hp":7872,"atk":208,"def":499.9,"sp":0.18},{"lv":76,"asc":5,"hp":7936.4,"atk":209.7,"def":504,"sp":0.18},{"lv":77,"asc":5,"hp":7999.9,"atk":211.4,"def":508,"sp":0.18},{"lv":78,"asc":5,"hp":8064.2,"atk":213.1,"def":512.1,"sp":0.18},{"lv":79,"asc":5,"hp":8127.8,"atk":214.8,"def":516.1,"sp":0.18},{"lv":80,"asc":5,"hp":8192.1,"atk":216.5,"def":520.2,"sp":0.18},{"lv":81,"asc":6,"hp":8667.8,"atk":229,"def":550.4,"sp":0.24},{"lv":82,"asc":6,"hp":8731.4,"atk":230.7,"def":554.4,"sp":0.24},{"lv":83,"asc":6,"hp":8795.7,"atk":232.4,"def":558.5,"sp":0.24},{"lv":84,"asc":6,"hp":8859.3,"atk":234.1,"def":562.6,"sp":0.24},{"lv":85,"asc":6,"hp":8923.6,"atk":235.8,"def":566.6,"sp":0.24},{"lv":86,"asc":6,"hp":8987.1,"atk":237.5,"def":570.7,"sp":0.24},{"lv":87,"asc":6,"hp":9051.5,"atk":239.2,"def":574.8,"sp":0.24},{"lv":88,"asc":6,"hp":9115,"atk":240.9,"def":578.8,"sp":0.24},{"lv":89,"asc":6,"hp":9179.4,"atk":242.6,"def":582.9,"sp":0.24},{"lv":90,"asc":6,"hp":9243.7,"atk":244.3,"def":587,"sp":0.24}],"talents":{"combat1":{"name":"宿灵闪箭","desc":"普通攻击\n进行至多三段的连续弓箭射击。\n\n重击\n进行伤害更高、更为精准的瞄准射击。\n瞄准时，雷元素会凭附在箭矢上。聚满了雷元素的箭矢会造成雷元素伤害。\n\n下落攻击\n从空中射出箭雨，并迅速下坠冲击地面，在落地时造成范围伤害。","labels":["一段伤害|{param1:F1P}","二段伤害|{param2:F1P}","三段伤害|{param3:F1P}","瞄准射击|{param4:F1P}","满蓄力瞄准射击|{param5:P}","下坠期间伤害|{param6:F1P}","低空/高空坠地冲击伤害|{param7:P}/{param8:P}"],"params":{"param1":[0.50642,0.54764,0.58886,0.647746,0.688966,0.736075,0.80085,0.865624,0.930399,1.001062,1.071725,1.142388,1.213052,1.283715,1.354378],"param2":[0.443734,0.479852,0.51597,0.567567,0.603685,0.644963,0.701719,0.758476,0.815233,0.877149,0.939065,1.000982,1.062898,1.124815,1.186731],"param3":[0.698208,0.755039,0.81187,0.893057,0.949888,1.014838,1.104143,1.193449,1.282755,1.380179,1.477603,1.575028,1.672452,1.769877,1.867301],"param4":[0.4386,0.4743,0.51,0.561,0.5967,0.6375,0.6936,0.7497,0.8058,0.867,0.9282,0.9894,1.0506,1.1118,1.173],"param5":[1.24,1.333,1.426,1.55,1.643,1.736,1.86,1.984,2.108,2.232,2.356,2.48,2.635,2.79,2.945],"param6":[0.568288,0.614544,0.6608,0.72688,0.773136,0.826,0.898688,0.971376,1.044064,1.12336,1.202656,1.281952,1.361248,1.440544,1.51984],"param7":[1.136335,1.228828,1.32132,1.453452,1.545944,1.65165,1.796995,1.94234,2.087686,2.246244,2.404802,2.563361,2.721919,2.880478,3.039036],"param8":[1.419344,1.534872,1.6504,1.81544,1.930968,2.063,2.244544,2.426088,2.607632,2.80568,3.003728,3.201776,3.399824,3.597872,3.79592]}},"combat2":{"name":"暝色缒索","desc":"欧洛伦将烟谜主亘古传承的秘术具现为暝色的宿灵球投向敌人，造成具有夜魂性质的雷元素伤害。\n附近存在其他敌人时，宿灵球将在附近的敌人间弹跳，造成具有夜魂性质的雷元素伤害。每次施放暝色缒索后，每名敌人只能被选为一次目标。\n进行3次弹跳或附近没有可以被选为目标的敌人时，宿灵球将消失。","labels":["宿灵球伤害|{param1:F1P}","冷却时间|{param2:F1}秒"],"params":{"param1":[1.976,2.1242,2.2724,2.47,2.6182,2.7664,2.964,3.1616,3.3592,3.5568,3.7544,3.952,4.199,4.446,4.693],"param2":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15]}},"combat3":{"name":"黯声回响","desc":"欧洛伦唤起远古的秘仪，造成具有夜魂性质的雷元素范围伤害，并召唤出「超音灵眼」。\n\n超音灵眼\n·持续嘲讽周围的敌人，吸引敌人攻击；\n·持续旋转并发射音波，对附近的敌人造成具有夜魂性质的雷元素伤害。","labels":["秘仪伤害|{param1:F1P}","音波碰撞伤害|{param2:F1P}","持续时间|{param3:F1}秒","冷却时间|{param4:F1}秒","元素能量|{param5:I}"],"params":{"param1":[1.74384,1.874628,2.005416,2.1798,2.310588,2.441376,2.61576,2.790144,2.964528,3.138912,3.313296,3.48768,3.70566,3.92364,4.14162],"param2":[0.332,0.3569,0.3818,0.415,0.4399,0.4648,0.498,0.5312,0.5644,0.5976,0.6308,0.664,0.7055,0.747,0.7885],"param3":[9,9,9,9,9,9,9,9,9,9,9,9,9,9,9],"param4":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15],"param5":[60,60,60,60,60,60,60,60,60,60,60,60,60,60,60]}}},"passives":[{"name":"夜翳的通感","desc":"队伍中的附近的角色触发「夜魂迸发」后，欧洛伦将获得40点夜魂值。施放元素战技后的15秒内，队伍中其他角色的元素类型为水元素或雷元素的攻击命中敌人时，欧洛伦将获得5点夜魂值，该效果每0.3秒至多触发一次，在持续期间内至多触发10次。\n欧洛伦的夜魂值上限为80点。\n\n此外，附近的敌人受到感电或月感电反应的伤害或队伍中附近的其他角色造成的具有夜魂性质的伤害时，若欧洛伦拥有至少10点夜魂值，欧洛伦将消耗10点夜魂值，进入夜魂加持状态，并触发「显象超感」效果：基于欧洛伦攻击力的160%，对周围至多4名敌人造成具有夜魂性质的雷元素伤害。上述效果每1.8秒至多触发一次。\n\n夜魂加持·欧洛伦\n欧洛伦的夜魂加持状态持续至多6秒。"},{"name":"灵相的触媒","desc":"元素战技暝色缒索中的宿灵球命中敌人后，欧洛伦将获得「灵相之印」效果，持续15秒。\n\n灵相之印\n队伍中附近的当前场上角色普攻、重击或下落攻击命中敌人后，将为该角色恢复3点元素能量；若欧洛伦处于队伍后台，还会为欧洛伦恢复3点元素能量。该效果每1秒至多触发一次，在持续期间内至多触发3次。"},{"name":"夜域赐礼·流雾跃影","desc":"在纳塔存在燃素机制的区域时，能够进行夜魂传递·欧洛伦。当前场上角色位于空中时，切换欧洛伦登场时触发：欧洛伦将高高腾跃而起。自己的队伍每10秒可以触发一次夜魂传递。\n\n长按瞄准时，欧洛伦会进入「灵觉」状态，处于这种状态下时，欧洛伦可以与「灵谜涂鸦」和「灵谜纹」交互，提取其中的信息与力量，这些物件的交互规则沿袭暝视龙的交互规则。\n\n此外，长按跳跃时，欧洛伦将消耗75点体力腾跃而起；在纳塔存在燃素机制的区域时，欧洛伦会优先消耗5点燃素，腾跃至更高的高度。\n位于空中时，欧洛伦可以长按普通攻击，消耗燃素或体力进行瞄准。"}],"icon":"assets/avatars/UI_AvatarIcon_Olorun.png"}