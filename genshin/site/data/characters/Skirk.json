}","低空/高空坠地冲击伤害|{param11:P}/{param12:P}","七相一闪模式持续时间|{param13:F1}秒","蛇之狡谋上限|{param14:F1}点","冷却时间|{param15:F1}秒"],"params":{"param1":[1.328244,1.436357,1.54447,1.698917,1.80703,1.930588,2.100479,2.270371,2.440263,2.625599,2.810935,2.996272,3.181608,3.366945,3.552281],"param2":[1.197997,1.295509,1.39302,1.532322,1.629833,1.741275,1.894507,2.047739,2.200972,2.368134,2.535296,2.702459,2.869621,3.036784,3.203946],"param3":[0.75723,0.818865,0.8805,0.96855,1.030185,1.100625,1.19748,1.294335,1.39119,1.49685,1.60251,1.70817,1.81383,1.91949,2.02515],"param4":[0.75723,0.818865,0.8805,0.96855,1.030185,1.100625,1.19748,1.294335,1.39119,1.49685,1.60251,1.70817,1.81383,1.91949,2.02515],"param5":[0.80539,0.870945,0.9365,1.03015,1.095705,1.170625,1.27364,1.376655,1.47967,1.59205,1.70443,1.81681,1.92919,2.04157,2.15395],"param6":[0.80539,0.870945,0.9365,1.03015,1.095705,1.170625,1.27364,1.376655,1.47967,1.59205,1.70443,1.81681,1.92919,2.04157,2.15395],"param7":[1.966244,2.126287,2.28633,2.514963,2.675006,2.857912,3.109409,3.360905,3.612401,3.886761,4.161121,4.43548,4.70984,4.984199,5.258559],"param8":[0.44548,0.48174,0.518,0.5698,0.60606,0.6475,0.70448,0.76146,0.81844,0.8806,0.94276,1.00492,1.06708,1.12924,1.1914],"param9":[20,20,20,20,20,20,20,20,20,20,20,20,20,20,20],"param10":[0.639324,0.691362,0.7434,0.81774,0.869778,0.92925,1.011024,1.092798,1.174572,1.26378,1.352988,1.442196,1.531404,1.620612,1.70982],"param11":[1.278377,1.382431,1.486485,1.635134,1.739187,1.858106,2.02162,2.185133,2.348646,2.527025,2.705403,2.883781,3.062159,3.240537,3.418915],"param12":[1.596762,1.726731,1.8567,2.04237,2.172339,2.320875,2.525112,2.729349,2.933586,3.15639,3.379194,3.601998,3.824802,4.047606,4.27041],"param13":[12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5,12.5],"param14":[100,100,100,100,100,100,100,100,100,100,100,100,100,100,100],"param15":[8,8,8,8,8,8,8,8,8,8,8,8,8,8,8]}},"combat3":{"name":"极恶技·灭","desc":"丝柯克的元素爆发不依靠元素能量，而是依靠**蛇之狡谋**。\n当丝柯克拥有至少50点蛇之狡谋时，丝柯克可以消耗所有蛇之狡谋，施放元素爆发，撕裂前方的空间并进行高速的连续斩击，造成冰元素范围伤害。同时，依据施放时丝柯克拥有的蛇之狡谋超过50点的部分，每1点蛇之狡谋都将提升本次元素爆发造成的伤害，至多通过这种方式计入12点蛇之狡谋。\n\n丝柯克处于**七相一闪**模式下时，元素爆发「极恶技·灭」将会被替换为「极恶技·尽」。\n\n极恶技·尽\n无需消耗蛇之狡谋即可施放的特殊元素爆发。\n施放后，丝柯克将获得凋尽效果，效果持续至七相一闪模式结束；解锁突破天赋**理外之理**后，丝柯克还将汲取附近一定范围内的虚境裂隙。\n凋尽效果持续期间，每0.1秒，丝柯克的普通攻击命中敌人后，将使本次普通攻击造成的伤害提高；若施放极恶技·尽时，汲取了虚境裂隙，则会依据汲取的虚境裂隙枚数，使本次普通攻击造成的伤害进一步提高。\n该效果将在触发次数达到10次时解除。","labels":["斩击伤害|{param1:F1P}*5","斩击最终段伤害|{param2:F1P}","蛇之狡谋加成|每点{param3:F2P}攻击力","汲取0/1/2/3枚虚境裂隙伤害提升|{param4:F1P}/{param5:F1P}/{param6:F1P}/{param7:F1P}","冷却时间|{param8:F1}秒"],"params":{"param1":[1.2276,1.31967,1.41174,1.5345,1.62657,1.71864,1.8414,1.96416,2.08692,2.20968,2.33244,2.4552,2.60865,2.7621,2.91555],"param2":[2.046,2.19945,2.3529,2.5575,2.71095,2.8644,3.069,3.2736,3.4782,3.6828,3.8874,4.092,4.34775,4.6035,4.85925],"param3":[0.193233,0.207726,0.222218,0.241542,0.256034,0.270527,0.28985,0.309173,0.328497,0.34782,0.367143,0.386467,0.410621,0.434775,0.458929],"param4":[0.035,0.04,0.045,0.05,0.055,0.06,0.065,0.07,0.075,0.08,0.085,0.09,0.095,0.1,0.105],"param5":[0.066,0.072,0.078,0.084,0.09,0.096,0.102,0.108,0.114,0.12,0.126,0.132,0.138,0.144,0.15],"param6":[0.088,0.096,0.104,0.112,0.12,0.128,0.136,0.144,0.152,0.16,0.168,0.176,0.184,0.192,0.2],"param7":[0.11,0.12,0.13,0.14,0.15,0.16,0.17,0.18,0.19,0.2,0.21,0.22,0.23,0.24,0.25],"param8":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15]}}},"passives":[{"name":"理外之理","desc":"队伍中附近的角色对敌人触发冻结、超导、星超导、冰元素扩散、星扩散或冰元素结晶反应时，将在敌人附近创造一枚虚境裂隙。该效果每2.5秒至多触发一次，场上至多存在3枚丝柯克自己创造的虚境裂隙。\n\n丝柯克可以通过以下方式，汲取附近一定范围内的虚境裂隙：\n·在**七相一闪**模式下进行的重击命中敌人时；\n·施放七相一闪模式下的特殊元素爆发极恶技·尽时；\n·长按施放元素战技极恶技·闪进行快速移动时。\n\n每汲取一枚虚境裂隙，丝柯克将获得8点**蛇之狡谋**。"},{"name":"万流归寂","desc":"队伍中附近的元素类型为水元素的角色的水元素攻击命中敌人时，或是队伍中附近的元素类型为冰元素的其他角色的冰元素攻击命中敌人时，丝柯克将获得一层持续20秒的死河渡断效果，至多叠加3层，每层独立计算持续时间。\n每名角色至多通过这种方式使丝柯克获得1层死河渡断效果。\n每层死河渡断效果会使丝柯克在**七相一闪**模式下时进行的普通攻击造成原本110%/120%/170%的伤害，且施放的元素爆发极恶技·灭造成原本105%/115%/160%的伤害。"},{"name":"诸武相授","desc":"队伍中所有角色的元素类型均为水元素或冰元素，并且至少有一名水元素角色、一名冰元素角色时，队伍中自己的角色的元素战技等级提高1级。"}],"icon":"assets/avatars/UI_AvatarIcon_SkirkNew.png"}