敌人，并在落地时造成范围伤害。","labels":["一段伤害|{param1:F1P}","二段伤害|{param3:F1P}+{param2:F1P}","三段伤害|{param5:F1P}+{param4:F1P}","四段伤害|{param6:F1P}+{param7:F1P}","五段伤害|{param8:F1P}+{param9:F1P}","重击伤害|{param10:F1P}+{param11:F1P}","重击体力消耗|{param12:F1}点","下坠期间伤害|{param13:F1P}","低空/高空坠地冲击伤害|{param14:P}/{param15:P}"],"params":{"param1":[0.654598,0.707879,0.76116,0.837276,0.890557,0.95145,1.035178,1.118905,1.202633,1.293972,1.385311,1.47665,1.56799,1.659329,1.750668],"param2":[0.445501,0.481762,0.518024,0.569826,0.606088,0.64753,0.704513,0.761495,0.818478,0.880641,0.942804,1.004967,1.067129,1.129292,1.191455],"param3":[0.239885,0.25941,0.278936,0.30683,0.326355,0.34867,0.379353,0.410036,0.440719,0.474191,0.507664,0.541136,0.574608,0.60808,0.641553],"param4":[0.60239,0.651421,0.700453,0.770498,0.81953,0.875566,0.952616,1.029666,1.106716,1.19077,1.274824,1.358879,1.442933,1.526988,1.611042],"param5":[0.324364,0.350765,0.377167,0.414884,0.441285,0.471459,0.512947,0.554435,0.595924,0.641184,0.686444,0.731704,0.776964,0.822224,0.867484],"param6":[0.554316,0.599434,0.644553,0.709008,0.754127,0.805691,0.876592,0.947493,1.018394,1.09574,1.173086,1.250433,1.327779,1.405126,1.482472],"param7":[0.298478,0.322772,0.347067,0.381774,0.406068,0.433834,0.472011,0.510188,0.548366,0.590014,0.631662,0.67331,0.714958,0.756606,0.798254],"param8":[0.697498,0.754271,0.811044,0.892148,0.948921,1.013805,1.10302,1.192235,1.28145,1.378775,1.4761,1.573425,1.670751,1.768076,1.865401],"param9":[0.375576,0.406146,0.436716,0.480388,0.510958,0.545895,0.593934,0.641973,0.690011,0.742417,0.794823,0.847229,0.899635,0.952041,1.004447],"param10":[0.856388,0.926094,0.9958,1.09538,1.165086,1.24475,1.354288,1.463826,1.573364,1.69286,1.812356,1.931852,2.051348,2.170844,2.29034],"param11":[0.461132,0.498666,0.5362,0.58982,0.627354,0.67025,0.729232,0.788214,0.847196,0.91154,0.975884,1.040228,1.104572,1.168916,1.23326],"param12":[50,50,50,50,50,50,50,50,50,50,50,50,50,50,50],"param13":[0.745878,0.806589,0.8673,0.95403,1.014741,1.084125,1.179528,1.274931,1.370334,1.47441,1.578486,1.682562,1.786638,1.890714,1.99479],"param14":[1.49144,1.612836,1.734233,1.907656,2.029052,2.167791,2.358556,2.549322,2.740087,2.948195,3.156303,3.364411,3.572519,3.780627,3.988735],"param15":[1.862889,2.01452,2.16615,2.382765,2.534396,2.707688,2.945964,3.184241,3.422517,3.682455,3.942393,4.202331,4.462269,4.722207,4.982145]}},"combat2":{"name":"烈风终坠","desc":"以绝对的力量，呈现西风剑术的真髓，依据点按、长按，以不同的方式产生效果。\n\n点按\n向前方腾跃而起并顺势劈斩，造成风元素范围伤害，并切换至**狂飙突进**模式。\n处于狂飙突进模式下时，法尔伽的普通攻击与重击造成的伤害提高，无法进行下落攻击，且进行普通攻击与重击时，将根据队伍中角色的元素类型，使双持的大剑分别造成无法被附魔覆盖的对应元素伤害。\n此外，处于狂飙突进模式下时，若队伍中存在火元素、水元素、雷元素或冰元素角色，法尔伽的元素战技烈风终坠将会被替换为特殊的元素战技**四风将起**，造成对应元素伤害与风元素伤害；此外，法尔伽还可以消耗特殊元素战技四风将起的可使用次数，进行不消耗体力的特殊重击苍噬，造成对应元素伤害与风元素伤害。\n\n长按\n进行蓄力后，向前方腾跃而起，蓄力时间会提升腾跃距离。","labels":["技能伤害|{param1:F1P}","点按冷却时间|{param19:F1}秒","长按冷却时间|{param20:F1}秒","狂飙突进·持续时间|{param2:F1}秒","狂飙突进·一段伤害|{param3:F1P}","狂飙突进·二段伤害|{param5:F1P}+{param4:F1P}","狂飙突进·三段伤害|{param7:F1P}+{param6:F1P}","狂飙突进·四段伤害|{param8:F1P}+{param9:F1P}","狂飙突进·五段伤害|{param10:F1P}+{param11:F1P}","狂飙突进·重击伤害|{param12:F1P}+{param13:F1P}","四风将起伤害|{param14:F1P}+{param15:F1P}","苍噬伤害|{param16:F1P}*2+{param17:F1P}*2","四风将起冷却时间|{param18:F1}秒"],"params":{"param1":[2.784,2.9928,3.2016,3.48,3.6888,3.8976,4.176,4.4544,4.7328,5.0112,5.2896,5.568,5.916,6.264,6.612],"param2":[12,12,12,12,12,12,12,12,12,12,12,12,12,12,12],"param3":[0.818247,0.884848,0.95145,1.046595,1.113196,1.189312,1.293972,1.398631,1.503291,1.617465,1.731639,1.845813,1.959987,2.074161,2.188335],"param4":[0.556876,0.602203,0.64753,0.712283,0.75761,0.809413,0.880641,0.951869,1.023097,1.100801,1.178505,1.256208,1.333912,1.411615,1.489319],"param5":[0.299856,0.324263,0.34867,0.383537,0.407944,0.435837,0.474191,0.512545,0.550899,0.592739,0.634579,0.67642,0.71826,0.760101,0.801941],"param6":[0.752987,0.814277,0.875566,0.963123,1.024413,1.094458,1.19077,1.287082,1.383395,1.488463,1.593531,1.698599,1.803666,1.908734,2.013802],"param7":[0.405455,0.438457,0.471459,0.518605,0.551607,0.5