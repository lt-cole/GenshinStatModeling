35174,0.037628,0.0409,0.043354,0.045808,0.04908,0.052352,0.055624,0.058896,0.062168,0.06544,0.06953,0.07362,0.07771],"param5":[269.62854,296.59515,325.80896,357.27,390.97824,426.93372,465.1364,505.5863,548.28345,593.2278,640.4193,689.8581,741.54407,795.4773,851.6577],"param6":[0.028,0.0301,0.0322,0.035,0.0371,0.0392,0.042,0.0448,0.0476,0.0504,0.0532,0.056,0.0595,0.063,0.0665],"param7":[1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5,1.5],"param8":[0.165,0.18,0.195,0.21,0.225,0.24,0.255,0.27,0.285,0.3,0.318,0.336,0.354,0.372,0.39],"param9":[6,6,6,6,6,6,6,6,6,6,6,6,6,6,6],"param10":[16,16,16,16,16,16,16,16,16,16,16,16,16,16,16]}},"combat3":{"name":"终奏·伴尔沉沦","desc":"领唱引诱沉沦的水妖之歌，造成水元素范围伤害。\n处于**遥久之歌**状态下时，造成的伤害还会进一步提升。","labels":["技能伤害|{param1:F1P}生命值上限","遥久之歌伤害加成|{param2:F1P}","冷却时间|{param3:F1}秒","元素能量|{param4:I}"],"params":{"param1":[0.456768,0.491026,0.525283,0.57096,0.605218,0.639475,0.685152,0.730829,0.776506,0.822182,0.867859,0.913536,0.970632,1.027728,1.084824],"param2":[0.48,0.516,0.552,0.6,0.636,0.672,0.72,0.768,0.816,0.864,0.912,0.96,1.02,1.08,1.14],"param3":[15,15,15,15,15,15,15,15,15,15,15,15,15,15,15],"param4":[60,60,60,60,60,60,60,60,60,60,60,60,60,60,60]}}},"passives":[{"name":"最后的塑诗者","desc":"施放元素战技宣叙·晨声纷流时，将使当前场上的星辉风旋转化为「流荡风旋」，且队伍中附近的角色在**遥久之歌**效果持续期间触发星扩散反应时，将取代星辉风旋创造流荡风旋。\n创造或引爆流荡风旋时，还会使附近敌人的风元素抗性降低35%，持续6秒。\n此外，遥久之歌持续期间，队伍中附近的角色进入辉映·星扩散状态时，辉映·星扩散的持续时间延长4秒。"},{"name":"十二弦的泪歌","desc":"施放元素战技宣叙·晨声纷流时，沃雅妮莎还会获得25层**「领唱」**与10层**「重唱」**。\n上述两种效果分别持续30秒，并会在施放元素战技时刷新层数。"},{"name":"余声绕冰湖","desc":"不处于战斗状态下时，长按元素战技，沃雅妮莎将显现出水妖的本貌，以消耗体力为代价，进行至多10秒的游动；因为是水妖，所以当然也可以在水面上移动。再次施放元素战技、持续时间结束或体力耗尽时，沃雅妮莎将不再维持水妖的本貌。\n此外，沃雅妮莎的游泳速度提升，但消耗体力的速度也更快。"}],"icon":"assets/avatars/UI_AvatarIcon_Vodyanitsa.png"}